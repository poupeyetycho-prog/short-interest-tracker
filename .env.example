# Copy to .env (or export these) — never commit real values.

# SEC EDGAR requires a descriptive User-Agent with a real contact address,
# otherwise it returns 403 and may block your IP briefly.
SEC_USER_AGENT="short-interest-tracker your@email.com"

# Enables the Claude synthesis layer behind the Reason buttons.
# Without it the app still works and shows the raw evidence dashboard.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Phone push alerts. Pick an unguessable topic name and subscribe to it
# in the ntfy app: https://ntfy.sh
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Optional — Reddit sentiment (free, non-commercial). Register an app at
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Alert tuning (defaults derived from the back-test study)
GATE_MIN_SHORT_PCT_FLOAT=15
GATE_MIN_DAYS_TO_COVER=3
WATCHLIST_MAX=50
